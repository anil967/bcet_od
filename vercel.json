{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/admin/login"
    },
    {
      "source": "/food/api/(.*)",
      "destination": "/api/food"
    },
    {
      "source": "/food",
      "destination": "/food/index.html"
    },
    {
      "source": "/food/",
      "destination": "/food/index.html"
    }
  ]
}
