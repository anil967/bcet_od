# Existing registration database settings
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/odyssey?retryWrites=true&w=majority
MONGODB_DB=odyssey
MONGODB_COLLECTION=student registration
PORT=5173

# Admin settings (never expose these values to browser code)
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-password.js
ADMIN_PASSWORD_HASH=